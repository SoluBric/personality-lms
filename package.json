{
	"name": "personality-lms",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"generate:courses": "node scripts/generate-course-catalog.mjs",
		"validate:courses": "node scripts/validate-course-system.mjs",
		"build": "vite build",
		"build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_WRITE_LOGS=false wrangler types && vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_WRITE_LOGS=false wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_WRITE_LOGS=false wrangler types"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.4.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0",
		"yaml": "^2.9.0"
	},
	"pnpm": {
		"overrides": {
			"cookie": "0.7.2"
		}
	}
}
